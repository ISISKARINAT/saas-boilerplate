# ============================================================
# EXEMPLE DE CONFIGURATION — copier en .env.local pour le dev
# ============================================================

# --- Base de données Turso ---
# URL de connexion à la base Turso (libsql://...)
TURSO_DATABASE_URL=libsql://your-db.turso.io
# Token d'authentification Turso
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- JWT ---
# Clé secrète utilisée pour signer les tokens JWT (min 32 caractères)
JWT_SECRET=change-me-to-a-long-random-secret-32-chars-min

# --- Stripe (abonnements) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Email (reset de mot de passe) ---
EMAIL_FROM=noreply@example.com
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=smtp-user
EMAIL_SERVER_PASSWORD=smtp-password

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
